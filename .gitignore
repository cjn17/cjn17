# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
env/
ENV/

# Jupyter Notebook
.ipynb_checkpoints

# Data files - don't commit potentially large or sensitive data
data/raw/
data/processed/

# Model files - these can be large
models/*.joblib
models/*.pkl

# Logs
logs/
*.log

# Reports - generated output
reports/visualizations/
reports/*.csv
reports/*.xlsx
reports/*.html
reports/*.png

# Environment variables
.env

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db 